import VOA.LatticesAndCodes.Codes.Defs
import VOA.LatticesAndCodes.Construction.CodeToLattice

/-!
# The extended Hamming code and the E₈ lattice

The binary extended Hamming code is the range of the systematic generator
`[I₄ | J₄ − I₄]`. Its sixteen codewords are doubly even; its rank is four,
so it is self-dual. Construction A therefore gives an even, unimodular,
positive definite lattice of rank eight, the E₈ lattice.
-/

namespace Code

/-- The systematic encoder for the extended binary Hamming `[8, 4, 4]` code. -/
def hamming8Enc : (Fin 4 → ZMod 2) →ₗ[ZMod 2] (Fin 8 → ZMod 2) where
  toFun x := ![x 0, x 1, x 2, x 3,
    x 1 + x 2 + x 3, x 0 + x 2 + x 3, x 0 + x 1 + x 3, x 0 + x 1 + x 2]
  map_add' x y := by
    ext i
    fin_cases i <;> simp <;> ring
  map_smul' a x := by
    ext i
    fin_cases i <;> simp <;> ring

/-- The extended binary Hamming code, generated by `[I₄ | J₄ − I₄]`. -/
def hamming8 : Code 2 8 := LinearMap.range hamming8Enc

/-- The systematic coordinates make the encoder injective. -/
theorem hamming8Enc_injective : Function.Injective hamming8Enc := by
  intro x y h
  funext i
  fin_cases i
  · simpa [hamming8Enc] using congrFun h 0
  · simpa [hamming8Enc] using congrFun h 1
  · simpa [hamming8Enc] using congrFun h 2
  · simpa [hamming8Enc] using congrFun h 3

/-- The extended Hamming code has dimension four. -/
theorem hamming8_rank : hamming8.rank = 4 := by
  change Module.finrank (ZMod 2) (LinearMap.range hamming8Enc) = 4
  rw [LinearMap.finrank_range_of_inj hamming8Enc_injective]
  simp

/-- All sixteen codewords have weight divisible by four. -/
theorem hamming8_isDoublyEven : hamming8.IsDoublyEven := by
  have h : ∀ x : Fin 4 → ZMod 2, 4 ∣ weight (hamming8Enc x) := by decide
  rintro _ ⟨x, rfl⟩
  exact h x

/-- Double evenness implies self-orthogonality of the extended Hamming code. -/
theorem hamming8_isSelfOrthogonal : hamming8.IsSelfOrthogonal :=
  hamming8_isDoublyEven.isSelfOrthogonal

/-- The self-orthogonal, half-dimensional extended Hamming code is self-dual. -/
theorem hamming8_isSelfDual : hamming8.IsSelfDual := by
  exact isSelfDual_iff.mpr ⟨hamming8_isSelfOrthogonal, by rw [hamming8_rank]⟩

/-- Construction A on the extended Hamming code gives an even lattice. -/
theorem hamming8_lattice_isEven :
    (latticeOfCode hamming8 hamming8_isSelfOrthogonal).IsEven :=
  (latticeOfCode_isEven hamming8 hamming8_isSelfOrthogonal).mpr hamming8_isDoublyEven

/-- Construction A on the extended Hamming code gives a unimodular lattice. -/
theorem hamming8_lattice_isUnimodular :
    (latticeOfCode hamming8 hamming8_isSelfOrthogonal).IsUnimodular :=
  (latticeOfCode_isUnimodular hamming8 hamming8_isSelfOrthogonal).mpr hamming8_isSelfDual

/-- Construction A on the extended Hamming code gives a positive definite lattice. -/
theorem hamming8_lattice_isPosDef :
    (latticeOfCode hamming8 hamming8_isSelfOrthogonal).IsPosDef :=
  latticeOfCode_isPosDef hamming8 hamming8_isSelfOrthogonal

end Code
